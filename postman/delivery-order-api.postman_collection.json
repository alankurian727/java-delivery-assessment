{
  "info": {
    "name": "Delivery Order API",
    "description": "Create and retrieve delivery orders. Select the **Local** environment. Folder 1 runs in order; the other folders use a new Idempotency-Key per request.\n\nTo see 503 `PRICING_UNAVAILABLE`, stop Pricing (`docker compose stop pricing-eligibility-api`) and run \"Create order\"; start it again and repeat the request with the same key to get 201.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create and retrieve",
      "description": "Run in order: the create request sets `idempotencyKey` and `orderId`, which the next requests use.",
      "item": [
        {
          "name": "Create order (eligible)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{deliveryOrderBaseUrl}}/api/v1/delivery-orders",
              "host": [
                "{{deliveryOrderBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "delivery-orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerReference\": \"CUSTOMER-ORDER-2026-001\",\n  \"sender\": {\n    \"name\": \"Test Sender\",\n    \"postalCode\": \"1012AB\",\n    \"countryCode\": \"NL\"\n  },\n  \"recipient\": {\n    \"name\": \"Test Recipient\",\n    \"postalCode\": \"5611EM\",\n    \"countryCode\": \"NL\"\n  },\n  \"parcel\": {\n    \"weightInGrams\": 2750\n  },\n  \"deliveryType\": \"NEXT_DAY\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The assignment's example: 8.95 = 6.95 NEXT_DAY base + 1.00 weight (2,750 g) + 1.00 urban surcharge (1012AB)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A new Idempotency-Key for this request, kept for the requests that repeat it.",
                  "pm.collectionVariables.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.test(\"Order is confirmed with the price\", () => {",
                  "    pm.expect(order.status).to.eql(\"CONFIRMED\");",
                  "    pm.expect(order.price).to.eql({ amount: 8.95, currency: \"EUR\" });",
                  "    pm.expect(order.createdAt).to.match(/[+-]\\d{2}:\\d{2}$/);",
                  "});",
                  "pm.test(\"Location points to the order\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v1/delivery-orders/\" + order.orderId);",
                  "});",
                  "pm.collectionVariables.set(\"orderId\", order.orderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Repeat the same request and key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{deliveryOrderBaseUrl}}/api/v1/delivery-orders",
              "host": [
                "{{deliveryOrderBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "delivery-orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerReference\": \"CUSTOMER-ORDER-2026-001\",\n  \"sender\": {\n    \"name\": \"Test Sender\",\n    \"postalCode\": \"1012 ab\",\n    \"countryCode\": \"NL\"\n  },\n  \"recipient\": {\n    \"name\": \"Test Recipient\",\n    \"postalCode\": \"5611EM\",\n    \"countryCode\": \"NL\"\n  },\n  \"parcel\": {\n    \"weightInGrams\": 2750\n  },\n  \"deliveryType\": \"NEXT_DAY\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Same key and the same request (the postal code is written differently but normalises to 1012AB): the stored order is returned; Pricing is not called again."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Same order is returned\", () => pm.expect(pm.response.json().orderId).to.eql(pm.collectionVariables.get(\"orderId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Same key, different request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{deliveryOrderBaseUrl}}/api/v1/delivery-orders",
              "host": [
                "{{deliveryOrderBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "delivery-orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerReference\": \"CUSTOMER-ORDER-2026-001\",\n  \"sender\": {\n    \"name\": \"Test Sender\",\n    \"postalCode\": \"1012AB\",\n    \"countryCode\": \"NL\"\n  },\n  \"recipient\": {\n    \"name\": \"Test Recipient\",\n    \"postalCode\": \"5611EM\",\n    \"countryCode\": \"NL\"\n  },\n  \"parcel\": {\n    \"weightInGrams\": 3000\n  },\n  \"deliveryType\": \"NEXT_DAY\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Problem Details with code IDEMPOTENCY_CONFLICT\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    pm.expect(pm.response.json().code).to.eql(\"IDEMPOTENCY_CONFLICT\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{deliveryOrderBaseUrl}}/api/v1/delivery-orders/{{orderId}}",
              "host": [
                "{{deliveryOrderBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "delivery-orders",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Stored order and price\", () => {",
                  "    pm.expect(pm.response.json().orderId).to.eql(pm.collectionVariables.get(\"orderId\"));",
                  "    pm.expect(pm.response.json().price.amount).to.eql(8.95);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
