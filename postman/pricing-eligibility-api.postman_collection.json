{
  "info": {
    "name": "Pricing & Eligibility API",
    "description": "Evaluate delivery eligibility and price. Select the **Local** environment. Each request uses a new `requestId`.\n\nIn production Pricing is called only by Delivery Order; these requests are for local testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Eligible (200)",
      "description": "",
      "item": [
        {
          "name": "Assignment example: NEXT_DAY 2,750 g, urban origin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{pricingBaseUrl}}/api/v1/pricing/evaluations",
              "host": [
                "{{pricingBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "pricing",
                "evaluations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{$guid}}\",\n  \"originPostalCode\": \"1012 AB\",\n  \"destinationPostalCode\": \"5611EM\",\n  \"weightInGrams\": 2750,\n  \"deliveryType\": \"NEXT_DAY\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "8.95 = 6.95 base + 1.00 weight + 1.00 urban surcharge."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Eligible, price 8.95\", () => {",
                  "    pm.expect(body.eligible).to.eql(true);",
                  "    pm.expect(body.price).to.eql({ amount: 8.95, currency: \"EUR\" });",
                  "});"
                ]
              }
            }
          ]
        },
