    {
      "name": "2. Business rejections (200, eligible: false)",
      "description": "A rejection is a successful evaluation with the answer \"no\", not an error.",
      "item": [
        {
          "name": "Weight above 20,000 g",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{pricingBaseUrl}}/api/v1/pricing/evaluations",
              "host": [
                "{{pricingBaseUrl}}"
