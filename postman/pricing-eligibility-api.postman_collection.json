            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{$guid}}\",\n  \"originPostalCode\": \"5611EM\",\n  \"destinationPostalCode\": \"3011AB\",\n  \"weightInGrams\": 20001,\n  \"deliveryType\": \"STANDARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Not eligible: WEIGHT_LIMIT_EXCEEDED\", () => {",
                  "    pm.expect(pm.response.json().eligible).to.eql(false);",
                  "    pm.expect(pm.response.json().rejectionCode).to.eql(\"WEIGHT_LIMIT_EXCEEDED\");",
                  "});"
                ]
              }
            }
          ]
        },
